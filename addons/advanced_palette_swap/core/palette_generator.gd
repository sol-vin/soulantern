@tool
class_name PaletteGenerator
extends RefCounted

## Handles generating shader include files and copying template shaders.
## Includes OKLab color space conversion for perceptually uniform color matching.

const TEMPLATE_SHADER_PATH: String = "res://addons/advanced_palette_swap/shaders/palette_swap.gdshader"
const TEMPLATE_CANVAS_SHADER_PATH: String = "res://addons/advanced_palette_swap/shaders/palette_swap_canvas.gdshader"
const TEMPLATE_INC_PATH: String = "res://addons/advanced_palette_swap/shaders/palette.gdshaderinc"

## Converts sRGB channel [0, 1] to Linear RGB
static func srgb_to_linear(c: float) -> float:
	c = clampf(c, 0.0, 1.0)
	if c <= 0.04045:
		return c / 12.92
	return pow((c + 0.055) / 1.055, 2.4)

## Converts an sRGB Color to OKLab space (L: perceived lightness, a: green/red, b: blue/yellow)
static func color_to_oklab(color: Color) -> Vector3:
	var lr = srgb_to_linear(color.r)
	var lg = srgb_to_linear(color.g)
	var lb = srgb_to_linear(color.b)

	var l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb
	var m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb
	var s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb

	var l_ = pow(maxf(l, 0.0), 1.0 / 3.0)
	var m_ = pow(maxf(m, 0.0), 1.0 / 3.0)
	var s_ = pow(maxf(s, 0.0), 1.0 / 3.0)

	return Vector3(
		0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
		1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
		0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
	)

## Generates the GDShader include code string with sRGB and precomputed OKLab values
static func generate_shaderinc_code(colors: Array[Color]) -> String:
	var size = maxi(colors.size(), 1)
	var lines: PackedStringArray = []
	lines.append("// Auto-generated by Advanced Palette Swap")
	lines.append("// Do not edit directly; modify via the Palette tab in the editor.")
	lines.append("")
	lines.append("#define PALETTE_SIZE %d" % size)
	lines.append("")
	lines.append("// sRGB Palette Colors")
	lines.append("const vec3 PALETTE[PALETTE_SIZE] = vec3[](")
	
	for i in range(size):
		var c = colors[i] if i < colors.size() else Color.BLACK
		var comma = "," if i < size - 1 else ""
		lines.append("\tvec3(%.6f, %.6f, %.6f)%s" % [c.r, c.g, c.b, comma])
		
	lines.append(");")
	lines.append("")
	lines.append("// Precomputed OKLab values for optimal perceptual color approximation")
	lines.append("const vec3 PALETTE_OKLAB[PALETTE_SIZE] = vec3[](")
	
	for i in range(size):
		var c = colors[i] if i < colors.size() else Color.BLACK
		var oklab = color_to_oklab(c)
		var comma = "," if i < size - 1 else ""
		lines.append("\tvec3(%.6f, %.6f, %.6f)%s" % [oklab.x, oklab.y, oklab.z, comma])
		
	lines.append(");")
	lines.append("")
	return "\n".join(lines)

## Writes the palette.gdshaderinc, palette_swap.gdshader, and palette_swap.material files in output_dir
static func write_palette_files(output_dir: String, colors: Array[Color], overwrite_main_shader: bool = false, params: Dictionary = {}) -> Dictionary:
	if colors.is_empty():
		return {
			"success": false,
			"error": "Cannot generate palette files with an empty palette."
		}

	# Normalize directory path
	var clean_dir = output_dir.strip_edges()
	if clean_dir.ends_with("/"):
		clean_dir = clean_dir.substr(0, clean_dir.length() - 1)
	if clean_dir.is_empty():
		clean_dir = "res://shaders/palette_swap"

	# Ensure target directory exists
	var err = DirAccess.make_dir_recursive_absolute(clean_dir)
	if err != OK and err != ERR_ALREADY_EXISTS:
		return {
			"success": false,
			"error": "Failed to create directory '%s' (Error code: %d)" % [clean_dir, err]
		}

	var inc_path = clean_dir.path_join("palette.gdshaderinc")
	var shader_path = clean_dir.path_join("palette_swap.gdshader")
	var material_path = clean_dir.path_join("palette_swap.material")
	var canvas_shader_path = clean_dir.path_join("palette_swap_canvas.gdshader")
	var canvas_material_path = clean_dir.path_join("palette_swap_canvas.material")

	# Write palette.gdshaderinc
	var inc_code = generate_shaderinc_code(colors)
	var file = FileAccess.open(inc_path, FileAccess.WRITE)
	if not file:
		return {
			"success": false,
			"error": "Failed to write file '%s': %s" % [inc_path, error_string(FileAccess.get_open_error())]
		}
	file.store_string(inc_code)
	file.close()

	# Ensure palette_swap.gdshader (spatial) exists in project directory
	var main_shader_exists = FileAccess.file_exists(shader_path)
	if not main_shader_exists or overwrite_main_shader:
		var template_file = FileAccess.open(TEMPLATE_SHADER_PATH, FileAccess.READ)
		if template_file:
			var template_code = template_file.get_as_text()
			template_file.close()
			
			var out_shader_file = FileAccess.open(shader_path, FileAccess.WRITE)
			if out_shader_file:
				out_shader_file.store_string(template_code)
				out_shader_file.close()
			else:
				return {
					"success": false,
					"error": "Failed to write shader file '%s'" % shader_path
				}
		else:
			return {
				"success": false,
				"error": "Could not locate template shader at '%s'" % TEMPLATE_SHADER_PATH
			}

	# Ensure palette_swap_canvas.gdshader (canvas_item) exists in project directory
	var canvas_shader_exists = FileAccess.file_exists(canvas_shader_path)
	if not canvas_shader_exists or overwrite_main_shader:
		var canvas_template_file = FileAccess.open(TEMPLATE_CANVAS_SHADER_PATH, FileAccess.READ)
		if canvas_template_file:
			var canvas_template_code = canvas_template_file.get_as_text()
			canvas_template_file.close()

			var out_canvas_shader_file = FileAccess.open(canvas_shader_path, FileAccess.WRITE)
			if out_canvas_shader_file:
				out_canvas_shader_file.store_string(canvas_template_code)
				out_canvas_shader_file.close()
			else:
				return {
					"success": false,
					"error": "Failed to write canvas shader file '%s'" % canvas_shader_path
				}
		else:
			return {
				"success": false,
				"error": "Could not locate canvas template shader at '%s'" % TEMPLATE_CANVAS_SHADER_PATH
			}

	# Generate or update palette_swap.material (spatial)
	var mat: ShaderMaterial = null
	if FileAccess.file_exists(material_path) or ResourceLoader.exists(material_path):
		var loaded_res = ResourceLoader.load(material_path, "ShaderMaterial", ResourceLoader.CACHE_MODE_REPLACE)
		if loaded_res is ShaderMaterial:
			mat = loaded_res

	if mat == null:
		mat = ShaderMaterial.new()

	# Assign spatial shader
	var shader_res = ResourceLoader.load(shader_path, "Shader", ResourceLoader.CACHE_MODE_REPLACE) as Shader
	if shader_res:
		mat.shader = shader_res

	# Set spatial shader parameters
	var default_params = {
		"dither_strength": 0.0,
		"color_distance_mode": 0,
		"input_lightness": 0.0,
		"input_saturation": 1.0,
		"input_contrast": 1.0,
		"input_red": 1.0,
		"input_green": 1.0,
		"input_blue": 1.0
	}

	for k in default_params.keys():
		var val = params.get(k, default_params[k])
		mat.set_shader_parameter(k, val)

	var save_err = ResourceSaver.save(mat, material_path)
	if save_err != OK:
		return {
			"success": false,
			"error": "Failed to save material to '%s' (Error code: %d)" % [material_path, save_err]
		}

	# Generate or update palette_swap_canvas.material (canvas_item)
	var canvas_mat: ShaderMaterial = null
	if FileAccess.file_exists(canvas_material_path) or ResourceLoader.exists(canvas_material_path):
		var loaded_canvas_res = ResourceLoader.load(canvas_material_path, "ShaderMaterial", ResourceLoader.CACHE_MODE_REPLACE)
		if loaded_canvas_res is ShaderMaterial:
			canvas_mat = loaded_canvas_res

	if canvas_mat == null:
		canvas_mat = ShaderMaterial.new()

	# Assign canvas shader
	var canvas_shader_res = ResourceLoader.load(canvas_shader_path, "Shader", ResourceLoader.CACHE_MODE_REPLACE) as Shader
	if canvas_shader_res:
		canvas_mat.shader = canvas_shader_res

	# Set canvas shader parameters
	var default_canvas_params = {
		"use_screen_texture": true,
		"dither_strength": 0.0,
		"color_distance_mode": 0,
		"input_lightness": 0.0,
		"input_saturation": 1.0,
		"input_contrast": 1.0,
		"input_red": 1.0,
		"input_green": 1.0,
		"input_blue": 1.0
	}

	for k in default_canvas_params.keys():
		var val = params.get(k, default_canvas_params[k])
		canvas_mat.set_shader_parameter(k, val)

	var canvas_save_err = ResourceSaver.save(canvas_mat, canvas_material_path)
	if canvas_save_err != OK:
		return {
			"success": false,
			"error": "Failed to save canvas material to '%s' (Error code: %d)" % [canvas_material_path, canvas_save_err]
		}

	# Generate or update palette_swap_canvas_item.material (direct CanvasItem mode: use_screen_texture = false)
	var canvas_item_material_path = clean_dir.path_join("palette_swap_canvas_item.material")
	var direct_canvas_mat: ShaderMaterial = null
	if FileAccess.file_exists(canvas_item_material_path) or ResourceLoader.exists(canvas_item_material_path):
		var loaded_direct = ResourceLoader.load(canvas_item_material_path, "ShaderMaterial", ResourceLoader.CACHE_MODE_REPLACE)
		if loaded_direct is ShaderMaterial:
			direct_canvas_mat = loaded_direct

	if direct_canvas_mat == null:
		direct_canvas_mat = ShaderMaterial.new()

	if canvas_shader_res:
		direct_canvas_mat.shader = canvas_shader_res

	for k in default_canvas_params.keys():
		var val = params.get(k, default_canvas_params[k])
		direct_canvas_mat.set_shader_parameter(k, val)
	# Explicitly set direct item mode
	direct_canvas_mat.set_shader_parameter("use_screen_texture", false)

	var direct_save_err = ResourceSaver.save(direct_canvas_mat, canvas_item_material_path)
	if direct_save_err != OK:
		return {
			"success": false,
			"error": "Failed to save direct canvas item material to '%s' (Error code: %d)" % [canvas_item_material_path, direct_save_err]
		}

	# Trigger editor filesystem rescan and reimport
	rescan_filesystem(PackedStringArray([inc_path, shader_path, material_path, canvas_shader_path, canvas_material_path, canvas_item_material_path]))

	return {
		"success": true,
		"inc_path": inc_path,
		"shader_path": shader_path,
		"material_path": material_path,
		"canvas_shader_path": canvas_shader_path,
		"canvas_material_path": canvas_material_path,
		"canvas_item_material_path": canvas_item_material_path,
		"material": mat,
		"canvas_material": canvas_mat,
		"canvas_item_material": direct_canvas_mat,
		"palette_size": colors.size()
	}

## Reads parameters from an existing ShaderMaterial file
static func read_material_parameters(material_path: String) -> Dictionary:
	var result = {}
	if not FileAccess.file_exists(material_path) and not ResourceLoader.exists(material_path):
		return result

	var mat = ResourceLoader.load(material_path, "ShaderMaterial", ResourceLoader.CACHE_MODE_REPLACE) as ShaderMaterial
	if not mat:
		return result

	var param_names = [
		"dither_strength", "color_distance_mode",
		"input_lightness", "input_saturation", "input_contrast",
		"input_red", "input_green", "input_blue"
	]
	for p in param_names:
		var val = mat.get_shader_parameter(p)
		if val != null:
			result[p] = val

	return result

## Rescans the editor filesystem and reimports changed shader files
static func rescan_filesystem(paths: PackedStringArray = PackedStringArray()) -> void:
	if Engine.is_editor_hint() and ClassDB.class_exists("EditorInterface"):
		var editor_interface = Engine.get_singleton("EditorInterface")
		if not editor_interface:
			# In Godot 4.2+, EditorInterface can be accessed directly or via tree
			var main_loop = Engine.get_main_loop()
			if main_loop is SceneTree and main_loop.root:
				# EditorInterface global is available
				pass
		
		# Use EditorInterface global if available
		var fs = null
		if "EditorInterface" in ClassDB.get_class_list():
			# Try global EditorInterface
			fs = EditorInterface.get_resource_filesystem()
		
		if fs:
			for p in paths:
				if FileAccess.file_exists(p):
					fs.update_file(p)
			if paths.size() > 0:
				fs.reimport_files(paths)
			fs.scan()

## Exports palette to a JSON file
static func export_to_json(filepath: String, colors: Array[Color]) -> bool:
	var hex_array: Array[String] = []
	for c in colors:
		hex_array.append(c.to_html(false))
	
	var data = {
		"name": filepath.get_file().get_basename(),
		"size": hex_array.size(),
		"colors": hex_array
	}
	
	var file = FileAccess.open(filepath, FileAccess.WRITE)
	if not file:
		return false
	file.store_string(JSON.stringify(data, "\t"))
	file.close()
	return true

## Imports palette from a JSON file
static func import_from_json(filepath: String) -> Array[Color]:
	var result: Array[Color] = []
	var file = FileAccess.open(filepath, FileAccess.READ)
	if not file:
		return result
	
	var text = file.get_as_text()
	file.close()
	
	var json = JSON.new()
	if json.parse(text) != OK:
		return result
	
	var data = json.get_data()
	if data is Dictionary and data.has("colors"):
		for hex_val in data["colors"]:
			result.append(Color.from_string(str(hex_val), Color.BLACK))
	elif data is Array:
		for hex_val in data:
			result.append(Color.from_string(str(hex_val), Color.BLACK))
			
	return result

## Exports palette to standard .hex format (one hex color per line)
static func export_to_hex(filepath: String, colors: Array[Color]) -> bool:
	var lines: PackedStringArray = []
	for c in colors:
		lines.append(c.to_html(false))
	var file = FileAccess.open(filepath, FileAccess.WRITE)
	if not file:
		return false
	file.store_string("\n".join(lines))
	file.close()
	return true

## Imports palette from .hex format
static func import_from_hex(filepath: String) -> Array[Color]:
	var result: Array[Color] = []
	var file = FileAccess.open(filepath, FileAccess.READ)
	if not file:
		return result
	var text = file.get_as_text()
	file.close()
	
	var lines = text.split("\n")
	for line in lines:
		var trimmed = line.strip_edges()
		if trimmed.is_empty() or (trimmed.begins_with("#") and trimmed.length() != 7 and trimmed.length() != 4):
			if not trimmed.begins_with("#"):
				continue
		var col = Color.from_string(trimmed, Color.BLACK)
		result.append(col)
	return result
